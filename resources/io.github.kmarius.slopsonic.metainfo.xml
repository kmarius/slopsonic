<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.kmarius.slopsonic</id>
  <name>Slopsonic</name>
  <summary>Feel at home with your music</summary>
  <developer id="io.github.kmarius">
    <name>kmarius</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <url type="homepage">https://github.com/kmarius/slopsonic</url>
  <url type="bugtracker">https://github.com/kmarius/slopsonic/issues</url>
  <url type="vcs-browser">https://github.com/kmarius/slopsonic</url>
  <branding>
    <color type="primary" scheme_preference="light">#8ecad6</color>
    <color type="primary" scheme_preference="dark">#28596b</color>
  </branding>
  <description>
    <p>Enjoy your Navidrome or OpenSubsonic music server with a native Linux music player.</p>
    <ul>
      <li>Supports Navidrome and OpenSubsonic servers.</li>
      <li>Transition and loudness normalization (server and embedded ReplayGain)</li>
      <li>Last.fm, Libre.fm and ListenBrainz scrobbling</li>
      <li>Downloads with offline playback, and transcoding</li>
      <li>MPRIS desktop media controls</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.kmarius.slopsonic.desktop</launchable>
  <content_rating type="oars-1.1" />
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>touch</control>
  </supports>
  <releases>
    <release version="0.0.1" />
  </releases>
</component>
