<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.20"/>

  <template class="SlopsonicHomeSectionHeaderView" parent="GtkBox">
    <property name="orientation">horizontal</property><property name="hexpand">true</property>
    <property name="halign">fill</property><property name="width-request">1</property>
    <child><object class="GtkLabel" id="heading"><property name="xalign">0</property><property name="width-chars">1</property><property name="ellipsize">end</property><property name="margin-end">9</property><style><class name="section-heading"/></style></object></child>
    <child><object class="GtkButton" id="play"><property name="icon-name">slopsonic-media-playback-start-symbolic</property><property name="tooltip-text">Play</property><accessibility><property name="label">Play</property></accessibility><style><class name="icon-button"/><class name="flat"/><class name="circular"/><class name="home-section-control-button"/></style></object></child>
    <child><object class="GtkButton" id="shuffle"><property name="icon-name">slopsonic-shuffle-symbolic</property><property name="tooltip-text">Shuffle</property><accessibility><property name="label">Shuffle</property></accessibility><style><class name="icon-button"/><class name="flat"/><class name="circular"/><class name="home-section-control-button"/></style></object></child>
    <child><object class="GtkButton" id="refresh"><property name="icon-name">slopsonic-view-refresh-symbolic</property><property name="tooltip-text">Refresh section</property><accessibility><property name="label">Refresh section</property></accessibility><style><class name="icon-button"/><class name="flat"/><class name="circular"/><class name="home-section-control-button"/></style></object></child>
    <child><object class="GtkBox"><property name="hexpand">true</property></object></child>
    <child>
      <object class="GtkBox">
        <property name="orientation">horizontal</property><property name="halign">end</property>
        <child><object class="GtkButton" id="previous"><property name="icon-name">slopsonic-go-previous-symbolic</property><property name="tooltip-text">Previous page</property><accessibility><property name="label">Previous page</property></accessibility><style><class name="icon-button"/><class name="flat"/><class name="circular"/></style></object></child>
        <child><object class="GtkButton" id="next"><property name="icon-name">slopsonic-go-next-symbolic</property><property name="tooltip-text">Next page</property><accessibility><property name="label">Next page</property></accessibility><style><class name="icon-button"/><class name="flat"/><class name="circular"/><class name="home-section-control-button"/></style></object></child>
      </object>
    </child>
  </template>
</interface>
