<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="AdwPreferencesPage" id="page">
    <property name="title" translatable="yes">General</property>
    <property name="icon-name">rufin-preferences-system-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup" id="window_group">
        <property name="title" translatable="yes">App settings</property>
        <child>
          <object class="AdwComboRow" id="starting_page_row">
            <property name="title" translatable="yes">Starting page</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="tray_row">
            <property name="title" translatable="yes">Show tray icon</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="keep_running_row">
            <property name="title" translatable="yes">Keep Slopsonic running after closing the window</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="start_minimized_row">
            <property name="title" translatable="yes">Start minimized</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="type_to_search_row">
            <property name="title" translatable="yes">Type to search</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Metadata</property>
        <child>
          <object class="AdwSwitchRow" id="prefer_distinct_track_covers_row">
            <property name="title" translatable="yes">Prefer distinct track covers</property>
            <property name="subtitle" translatable="yes">Use each track's own cover when available</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="external_metadata_row">
            <property name="title" translatable="yes">External metadata lookup</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title" translatable="yes">Notifications</property>
        <child>
          <object class="AdwSwitchRow" id="control_notifications_row">
            <property name="title" translatable="yes">Control notifications</property>
          </object>
        </child>
        <child>
          <object class="AdwSwitchRow" id="notifications_row">
            <property name="title" translatable="yes">Now playing notifications</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
