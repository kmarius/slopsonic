<?xml version="1.0" encoding="UTF-8"?>
<interface domain="rufin">
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="AdwPreferencesPage" id="playback_page">
    <property name="title" translatable="yes">Playback</property>
    <property name="icon-name">rufin-music-queue-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup" id="transition_group">
        <property name="title" translatable="yes">Queue and transitions</property>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="audio_group">
        <property name="title" translatable="yes">Audio</property>
      </object>
    </child>
  </object>
  <object class="AdwPreferencesPage" id="equalizer_page">
    <property name="title" translatable="yes">Equalizer</property>
    <child>
      <object class="AdwPreferencesGroup" id="equalizer_group" />
    </child>
  </object>
  <object class="AdwSwitchRow" id="audio_fade_row">
    <property name="title" translatable="yes">Audio fade on play/pause</property>
    <property name="subtitle" translatable="yes">Fade audio when playback is paused or resumed</property>
  </object>
  <object class="AdwSwitchRow" id="skip_unplayable_row">
    <property name="title" translatable="yes">Skip unplayable tracks</property>
  </object>
  <object class="AdwActionRow" id="refill_row">
    <property name="title" translatable="yes">Auto DJ refill threshold</property>
    <property name="subtitle" translatable="yes">Add tracks when fewer than this many remain</property>
    <child type="suffix">
      <object class="GtkSpinButton" id="refill">
        <property name="valign">center</property>
      </object>
    </child>
  </object>
  <object class="AdwSwitchRow" id="clear_queue_row">
    <property name="title" translatable="yes">Clearing queue also clears the current song</property>
  </object>
</interface>
