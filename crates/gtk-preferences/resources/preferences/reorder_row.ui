<?xml version="1.0" encoding="UTF-8"?>
<interface domain="slopsonic">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>

  <template class="SlopsonicPreferencesReorderRow" parent="AdwActionRow">
    <child type="prefix">
      <object class="GtkImage" id="drag">
        <property name="icon-name">slopsonic-list-drag-handle-symbolic</property>
        <property name="tooltip-text" translatable="yes">Drag to reorder</property>
        <style><class name="dim-label"/></style>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkButton" id="up">
        <property name="icon-name">slopsonic-go-up-symbolic</property>
        <property name="tooltip-text" translatable="yes">Move up</property>
        <property name="valign">center</property>
        <style><class name="flat"/></style>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkButton" id="down">
        <property name="icon-name">slopsonic-go-down-symbolic</property>
        <property name="tooltip-text" translatable="yes">Move down</property>
        <property name="valign">center</property>
        <style><class name="flat"/></style>
      </object>
    </child>
    <child type="suffix">
      <object class="GtkSwitch" id="visible">
        <property name="valign">center</property>
      </object>
    </child>
  </template>
</interface>
