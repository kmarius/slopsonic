<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwPreferencesGroup" id="display_group">
    <property name="title">Display</property>
    <child><object class="AdwActionRow" id="size_row">
      <property name="title">Size</property>
      <child type="suffix"><object class="AdwToggleGroup" id="size">
        <property name="valign">center</property>
        <property name="can-shrink">true</property>
        <child><object class="AdwToggle"><property name="label">Compact</property></object></child>
        <child><object class="AdwToggle"><property name="label">Default</property></object></child>
        <child><object class="AdwToggle" id="size_large"><property name="label">Large</property></object></child>
      </object></child>
    </object></child>
    <child><object class="AdwActionRow" id="spacing_row">
      <property name="title">Grid spacing</property>
      <child type="suffix"><object class="AdwToggleGroup" id="spacing">
        <property name="valign">center</property>
        <property name="can-shrink">true</property>
        <child><object class="AdwToggle"><property name="label">Small</property></object></child>
        <child><object class="AdwToggle"><property name="label">Default</property></object></child>
        <child><object class="AdwToggle"><property name="label">Wide</property></object></child>
      </object></child>
    </object></child>
    <child><object class="AdwSwitchRow" id="show_header"><property name="title">Show header</property></object></child>
    <child><object class="AdwSwitchRow" id="hover_highlight"><property name="title">Highlight hovered row</property></object></child>
    <child><object class="AdwSwitchRow" id="alternate_rows"><property name="title">Alternate row colors</property></object></child>
    <child><object class="AdwSwitchRow" id="row_borders"><property name="title">Row borders</property></object></child>
    <child><object class="AdwSwitchRow" id="column_borders"><property name="title">Column borders</property></object></child>
  </object>
</interface>
