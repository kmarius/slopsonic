<?xml version="1.0" encoding="UTF-8"?>
<interface domain="slopsonic">
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>

  <object class="AdwDialog" id="new_dialog">
    <property name="title" translatable="yes">New Playlist</property>
    <property name="content-width">320</property>
    <property name="default-widget">new_create</property>
    <property name="focus-widget">new_entry</property>
    <property name="child"><object class="AdwToolbarView">
        <child type="top"><object class="AdwHeaderBar"/></child>
        <property name="content">
          <object class="GtkBox">
            <property name="orientation">vertical</property>
            <property name="spacing">12</property>
            <property name="margin-start">18</property>
            <property name="margin-end">18</property>
            <property name="margin-bottom">18</property>
            <child>
              <object class="GtkOverlay">
                <property name="child">
                  <object class="GtkEntry" id="new_entry">
                    <property name="placeholder-text" translatable="yes">Playlist name</property>
                    <property name="activates-default">true</property>
                    <style><class name="playlist-name-owner-entry"/></style>
                  </object>
                </property>
                <child type="overlay">
                  <object class="GtkToggleButton" id="new_owner">
                    <property name="halign">end</property>
                    <property name="valign">center</property>
                    <property name="margin-end">4</property>
                    <style>
                      <class name="flat"/>
                      <class name="circular"/>
                      <class name="playlist-name-owner"/>
                    </style>
                  </object>
                </child>
              </object>
            </child>
            <child><object class="GtkBox" id="new_public_options">
                <property name="visible">false</property>
                <property name="spacing">8</property>
                <child><object class="GtkSwitch" id="new_public">
                    <property name="valign">center</property>
                    <accessibility><relation name="labelled-by">new_public_label</relation></accessibility>
                  </object></child>
                <child><object class="GtkLabel" id="new_public_label"><property name="label" translatable="yes">Public</property></object></child>
              </object></child>
            <child><object class="GtkBox">
                <property name="halign">end</property>
                <property name="spacing">8</property>
                <property name="margin-top">6</property>
                <child><object class="GtkButton" id="new_cancel"><property name="label" translatable="yes">Cancel</property></object></child>
                <child><object class="GtkButton" id="new_create"><property name="label" translatable="yes">Create</property><style><class name="suggested-action"/></style></object></child>
              </object></child>
          </object>
        </property>
      </object></property>
  </object>

  <object class="AdwDialog" id="edit_dialog">
    <property name="title" translatable="yes">Edit Playlist</property>
    <property name="content-width">680</property>
    <property name="default-widget">save_edit</property>
    <property name="focus-widget">name_entry</property>
    <property name="child">
      <object class="AdwToolbarView" id="edit_toolbar">
        <child type="top"><object class="AdwHeaderBar">
            <property name="show-start-title-buttons">false</property>
            <property name="show-end-title-buttons">false</property>
            <child type="start"><object class="GtkButton" id="cancel_edit"><property name="label" translatable="yes">Cancel</property></object></child>
            <child type="end"><object class="GtkButton" id="save_edit"><property name="label" translatable="yes">Apply</property><style><class name="suggested-action"/></style></object></child>
          </object></child>
        <property name="content">
          <object class="GtkScrolledWindow">
            <property name="hscrollbar-policy">never</property>
            <property name="vscrollbar-policy">automatic</property>
            <property name="propagate-natural-height">true</property>
            <property name="propagate-natural-width">true</property>
            <property name="max-content-width">480</property>
            <property name="child">
              <object class="GtkBox" id="editor_content">
                <property name="orientation">vertical</property>
                <property name="spacing">18</property>
                <property name="margin-start">18</property>
                <property name="margin-end">18</property>
                <property name="margin-bottom">18</property>
                <child>
                  <object class="AdwWrapBox" id="editor_layout">
                    <property name="child-spacing">18</property>
                    <property name="line-spacing">18</property>
                    <child>
                      <object class="GtkBox" id="playlist_options">
                        <property name="orientation">vertical</property>
                        <property name="spacing">12</property>
                        <property name="hexpand">true</property>
                        <property name="valign">start</property>
                        <child><object class="GtkEntry" id="name_entry"><property name="activates-default">true</property><property name="placeholder-text" translatable="yes">Playlist name</property><property name="hexpand">true</property></object></child>
                        <child><object class="GtkBox" id="playlist_public_options">
                            <property name="visible">false</property>
                            <property name="spacing">8</property>
                            <child><object class="GtkSwitch" id="playlist_public"><property name="valign">center</property><accessibility><relation name="labelled-by">playlist_public_label</relation></accessibility></object></child>
                            <child><object class="GtkLabel" id="playlist_public_label"><property name="label" translatable="yes">Public</property></object></child>
                          </object></child>
                      </object>
                    </child>
                  </object>
                </child>

              </object>
            </property>
          </object>
        </property>
      </object>
    </property>
  </object>
</interface>
