<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="AdwPreferencesPage" id="playback_page">
    <property name="title">Playback</property>
    <property name="icon-name">slopsonic-music-queue-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup" id="transition_group">
        <property name="title">Queue and transitions</property>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="audio_group">
        <property name="title">Audio</property>
      </object>
    </child>
  </object>
  <object class="AdwSwitchRow" id="audio_fade_row">
    <property name="title">Audio fade on play/pause</property>
    <property name="subtitle">Fade audio when playback is paused or resumed</property>
  </object>
  <object class="AdwSwitchRow" id="skip_unplayable_row">
    <property name="title">Skip unplayable tracks</property>
  </object>
  <object class="AdwActionRow" id="refill_row">
    <property name="title">Auto DJ refill threshold</property>
    <property name="subtitle">Add tracks when fewer than this many remain</property>
    <child type="suffix">
      <object class="GtkSpinButton" id="refill">
        <property name="valign">center</property>
      </object>
    </child>
  </object>
  <object class="AdwSwitchRow" id="clear_queue_row">
    <property name="title">Clearing queue also clears the current song</property>
  </object>
</interface>
