<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.20" />
  <requires lib="libadwaita" version="1.9" />
  <object class="AdwPreferencesPage" id="appearance_page">
    <property name="title">Customization</property>
    <property name="icon-name">slopsonic-preferences-desktop-appearance-symbolic</property>
    <child>
      <object class="AdwPreferencesGroup">
        <property name="title">Accessibility</property>
        <child>
          <object class="AdwSwitchRow" id="reduce_motion">
            <property name="title">Reduce motion</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="layout_group">
        <property name="title">Layout</property>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="sidebar_items_group">
        <child>
          <object class="AdwExpanderRow" id="sidebar_items">
            <property name="title">Sidebar Items</property>
            <property name="expanded">false</property>
            <child>
              <object class="AdwSwitchRow" id="sidebar_pins_row">
                <property name="title">Pins</property>
                <property name="subtitle">Fixed position</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="home_blocks_group">
        <child>
          <object class="AdwExpanderRow" id="home_blocks">
            <property name="title">Home Blocks</property>
            <property name="expanded">false</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwPreferencesGroup" id="context_menus_group">
        <child>
          <object class="AdwExpanderRow" id="context_menus">
            <property name="title">Context Menus</property>
            <property name="expanded">false</property>
            <child>
              <object class="AdwSwitchRow" id="context_menu_play">
                <property name="title">Play</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_play_next">
                <property name="title">Play Next</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_play_later">
                <property name="title">Play Later</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_play_radio">
                <property name="title">Play radio</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_playlist">
                <property name="title">Add to Playlist</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_favorites">
                <property name="title">Favorites</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_pins">
                <property name="title">Pins</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_go_to">
                <property name="title">Go to</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_download">
                <property name="title">Download</property>
              </object>
            </child>
            <child>
              <object class="AdwSwitchRow" id="context_menu_rating_row">
                <property name="title">Rating</property>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
  <object class="AdwSwitchRow" id="narrow_row">
    <property name="title">Use different layout below a threshold width</property>
  </object>
  <object class="AdwSpinRow" id="threshold_row">
    <property name="title">Narrow layout threshold</property>
    <property name="digits">0</property>
    <property name="numeric">true</property>
    <child type="suffix">
      <object class="GtkLabel">
        <property name="label">px</property>
        <style>
          <class name="dim-label" />
        </style>
      </object>
    </child>
  </object>
</interface>
