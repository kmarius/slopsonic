<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.20"/>
  <requires lib="libadwaita" version="1.9"/>
  <object class="AdwPreferencesPage" id="theme_page">
    <property name="title">Theme</property>
    <child>
      <object class="AdwPreferencesGroup">
        <child><object class="AdwComboRow" id="scheme_row">
          <property name="title">Color scheme</property>
          <property name="model"><object class="GtkStringList"><items>
            <item>System</item><item>Light</item><item>Dark</item>
          </items></object></property>
        </object></child>
        <child><object class="AdwComboRow" id="accent_row">
          <property name="title">Accent color</property>
          <property name="model"><object class="GtkStringList"><items>
            <item>System</item><item>Blue</item><item>Teal</item>
            <item>Green</item><item>Yellow</item><item>Orange</item>
            <item>Red</item><item>Pink</item><item>Purple</item><item>Slate</item>
          </items></object></property>
        </object></child>
      </object>
    </child>
  </object>
</interface>
