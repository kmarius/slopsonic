{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Renovate owns dependency updates for Cargo crates, GitHub Actions, and Nix inputs.",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "cargo",
    "github-actions",
    "nix"
  ],
  "nix": {
    "enabled": true
  },
  "dependencyDashboard": false,
  "minimumReleaseAge": "7 days",
  "lockFileMaintenance": {
    "enabled": true
  },
  "prHourlyLimit": 0
}
